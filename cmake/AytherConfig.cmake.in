@PACKAGE_INIT@

# Installed AYTHER package. Consumers need neither Cargo nor Corrosion.
include(CMakeFindDependencyMacro)

unset(Ayther_NOT_FOUND_MESSAGE)
set(_ayther_supported_components core engine)
foreach(_ayther_component IN LISTS Ayther_FIND_COMPONENTS)
    if(NOT _ayther_component IN_LIST _ayther_supported_components)
        set(Ayther_${_ayther_component}_FOUND FALSE)
        set(Ayther_FOUND FALSE)
        set(Ayther_NOT_FOUND_MESSAGE
            "Unsupported Ayther component '${_ayther_component}'. "
            "Supported components are: core, engine.")
        unset(_ayther_component)
        unset(_ayther_supported_components)
        return()
    endif()
endforeach()

set_and_check(AYTHER_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(AYTHER_LIB_DIR     "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

set(Ayther_core_FOUND TRUE)
if(@AYTHER_PACKAGE_HAS_ENGINE@)
    set(Ayther_engine_FOUND TRUE)
else()
    set(Ayther_engine_FOUND FALSE)
endif()

set(_ayther_core_archive
    "${AYTHER_LIB_DIR}/@AYTHER_CORE_ARCHIVE_NAME@")
if(NOT EXISTS "${_ayther_core_archive}")
    set(Ayther_FOUND FALSE)
    set(Ayther_NOT_FOUND_MESSAGE
        "The installed AYTHER core archive is missing: ${_ayther_core_archive}")
    return()
endif()

if(NOT TARGET Ayther::core)
    add_library(Ayther::core STATIC IMPORTED)
    set_target_properties(Ayther::core PROPERTIES
        IMPORTED_LOCATION                 "${_ayther_core_archive}"
        IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
        INTERFACE_INCLUDE_DIRECTORIES     "${AYTHER_INCLUDE_DIR}")

    set(_ayther_core_system_libs "@AYTHER_CORE_SYSTEM_LIBS@")
    if(_ayther_core_system_libs)
        set_property(TARGET Ayther::core APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES "${_ayther_core_system_libs}")
    endif()

    set(_ayther_core_link_options "@AYTHER_CORE_LINK_OPTIONS@")
    if(_ayther_core_link_options)
        set_property(TARGET Ayther::core APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "${_ayther_core_link_options}")
    endif()
endif()

if(Ayther_engine_FOUND)
    # Public, relocatable asset contract for installed Engine consumers.
    set_and_check(
        Ayther_SHADER_DIR
        "${PACKAGE_PREFIX_DIR}/share/Ayther/shaders"
    )

    find_dependency(Threads)
    find_dependency(SDL3 CONFIG)
    find_dependency(Vulkan)
    find_dependency(VulkanMemoryAllocator CONFIG)
    find_dependency(tomlplusplus CONFIG)
    find_dependency(zstd CONFIG)

    set(_ayther_package_dependency_targets
        Threads::Threads
        SDL3::SDL3
        Vulkan::Vulkan
        GPUOpen::VulkanMemoryAllocator
        tomlplusplus::tomlplusplus
        zstd::libzstd)
    foreach(_ayther_dependency_target IN LISTS
            _ayther_package_dependency_targets)
        if(NOT TARGET "${_ayther_dependency_target}")
            set(Ayther_FOUND FALSE)
            set(Ayther_NOT_FOUND_MESSAGE
                "A native dependency did not provide its required CMake "
                "target: ${_ayther_dependency_target}")
            return()
        endif()
    endforeach()

    # SDL3::SDL3 is an upstream convenience alias that CMake otherwise resolves
    # to a concrete `-shared` or `-static` target while generating the export.
    # Keep that implementation choice behind a package-owned adapter.
    if(NOT TARGET Ayther::sdl3)
        add_library(Ayther::sdl3 INTERFACE IMPORTED)
        set_property(TARGET Ayther::sdl3 PROPERTY
            INTERFACE_LINK_LIBRARIES SDL3::SDL3)
    endif()

    # Keep platform linker names such as Linux's `dl` behind a CMake target so
    # Ayther::engine's installed interface contains targets, never raw
    # platform libraries or producer paths.
    if(NOT TARGET Ayther::platform)
        add_library(Ayther::platform INTERFACE IMPORTED)
        if(CMAKE_DL_LIBS)
            set_property(TARGET Ayther::platform PROPERTY
                INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}")
        endif()
    endif()

    if(@AYTHER_PACKAGE_HAS_VPX@)
        if(@AYTHER_PACKAGE_VPX_BUNDLED@)
            set(_ayther_vpx_archive
                "${AYTHER_LIB_DIR}/@AYTHER_VPX_ARCHIVE_NAME@")
            if(NOT EXISTS "${_ayther_vpx_archive}")
                set(Ayther_FOUND FALSE)
                set(Ayther_NOT_FOUND_MESSAGE
                    "The installed AYTHER libvpx archive is missing: "
                    "${_ayther_vpx_archive}")
                return()
            endif()

            if(NOT TARGET Ayther::vpx)
                add_library(Ayther::vpx STATIC IMPORTED)
                set_target_properties(Ayther::vpx PROPERTIES
                    IMPORTED_LOCATION             "${_ayther_vpx_archive}"
                    INTERFACE_INCLUDE_DIRECTORIES "${AYTHER_INCLUDE_DIR}")
            endif()
        else()
            find_dependency(PkgConfig)
            pkg_check_modules(AytherSystemVpx REQUIRED IMPORTED_TARGET vpx)
            if(NOT TARGET Ayther::vpx)
                add_library(Ayther::vpx INTERFACE IMPORTED)
                set_property(TARGET Ayther::vpx PROPERTY
                    INTERFACE_LINK_LIBRARIES PkgConfig::AytherSystemVpx)
            endif()
        endif()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/AytherEngineTargets.cmake")

    if(NOT TARGET Ayther::engine)
        set(Ayther_engine_FOUND FALSE)
        set(Ayther_FOUND FALSE)
        set(Ayther_NOT_FOUND_MESSAGE
            "The installed AYTHER package did not define Ayther::engine.")
        return()
    endif()

    # Corrosion's build-tree target is installed as a plain archive and
    # reconstructed above. Attach that installed target after loading the
    # generated export so Ayther::engine consumers inherit the core archive
    # without leaking the non-exportable build-tree alias.
    set_property(TARGET Ayther::engine APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES Ayther::core)
endif()

unset(_ayther_core_archive)
unset(_ayther_core_system_libs)
unset(_ayther_core_link_options)
unset(_ayther_vpx_archive)
unset(_ayther_dependency_target)
unset(_ayther_package_dependency_targets)
unset(_ayther_component)
unset(_ayther_supported_components)

check_required_components(Ayther)
